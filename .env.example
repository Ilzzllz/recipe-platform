# ================================================================
#  Recipe Platform — переменные окружения
#  cp .env.example .env   и заполните значения.  .env НЕ коммитить!
# ================================================================

# ---------- PostgreSQL ----------
DB_NAME=recipe_db
DB_USERNAME=postgres
DB_PASSWORD=change_me_strong_password
# Порт PostgreSQL на хосте (5433, чтобы не конфликтовать с локальным Postgres)
DB_EXTERNAL_PORT=5433

# ---------- Backend (Spring Boot) ----------
# JDBC-URL. Внутри docker-compose хост БД — имя сервиса "db".
DB_URL=jdbc:postgresql://db:5432/recipe_db
# Порт, который слушает Spring Boot (PaaS обычно передаёт свой PORT сам)
BACKEND_PORT=8080
PORT=8080
# Разрешённые CORS origin-паттерны через запятую
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseSerialGC

# ---------- Frontend (React / Vite / Nginx) ----------
# Базовый URL API, вшивается в бандл при сборке (VITE_API_URL).
# Пусто -> фронтенд ходит на относительный /api, его проксирует Nginx.
# Для раздельного хостинга: https://recipe-platform-backend.onrender.com
API_URL=
FRONTEND_PORT=3000
